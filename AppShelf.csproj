<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AppShelf</AssemblyName>
    <!-- Shared assembly attributes are compiled by both build paths. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>Assets\AppShelf.ico</ApplicationIcon>
    <RootNamespace>AppShelf</RootNamespace>
    <StartupObject>AppShelf.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Include="Assets\AppShelf.png" LogicalName="AppShelf.Brand.png" />
  </ItemGroup>
</Project>
